# ═══════════════════════════════════════════════════════
#  eMobilityHub – environment variables
#  Copy to .env and change the values:  cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=emobility
MYSQL_USER=student
MYSQL_PASSWORD=student

# ── JWT signing key (Base64/hex, at least 256 bits) ─────
# Development key only. For anything shared, generate one with:  openssl rand -hex 32
JWT_SIGNING_KEY=413F4428472B4B6250655368566D5970337336763979244226452948404D6351

# ── Session cookie ──────────────────────────────────────
# true when the site is served over HTTPS
AUTH_COOKIE_SECURE=false
