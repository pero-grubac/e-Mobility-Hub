<%-- "Report broken" dialog shared by the vehicle lists. --%>
<div class="modal fade" id="brokenModal" tabindex="-1" aria-labelledby="brokenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content needs-validation" method="post" action="clients" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="brokenModalLabel">Report a broken vehicle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="action" value="brokenVehicle">
                <input type="hidden" id="brokenVehicleId" name="vehicleId">
                <p class="mb-2" id="brokenVehicleName"></p>
                <label for="reason" class="form-label">What is wrong?</label>
                <textarea class="form-control" id="reason" name="reason" rows="3" maxlength="1500" required
                          placeholder="e.g. the brakes do not work"></textarea>
                <div class="invalid-feedback">Please describe the problem.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning">Send report</button>
            </div>
        </form>
    </div>
</div>
<script>
    document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-report]');
        if (!button) {
            return;
        }
        document.getElementById('brokenVehicleId').value = button.dataset.report;
        document.getElementById('brokenVehicleName').textContent = button.dataset.name;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('brokenModal')).show();
    });
</script>
