<%-- One-time messages set by the controller after an action. --%>
<%
    String flashError = (String) session.getAttribute("flashError");
    String flashSuccess = (String) session.getAttribute("flashSuccess");
    session.removeAttribute("flashError");
    session.removeAttribute("flashSuccess");
%>
<% if (flashSuccess != null) { %>
<div class="alert alert-success" role="status"><%= org.unibl.etf.emobility_hub_user.util.Html.escape(flashSuccess) %></div>
<% } %>
<% if (flashError != null) { %>
<div class="alert alert-danger" role="alert"><%= org.unibl.etf.emobility_hub_user.util.Html.escape(flashError) %></div>
<% } %>
